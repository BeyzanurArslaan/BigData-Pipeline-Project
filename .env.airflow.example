# Airflow metadata database
AIRFLOW_UID=50000
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-postgres:5432/airflow

# Airflow core configuration
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-for-local-demo

# Local demo admin user created by airflow-init
# Change these values for any non-local deployment.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@local.test

# External services reachable from Airflow containers
AIRFLOW_SPARK_MASTER_URL=spark://spark-master:7077
AIRFLOW_SPARK_THRIFTSERVER_HOST=spark-thriftserver
AIRFLOW_SPARK_THRIFTSERVER_PORT=10000
AIRFLOW_HDFS_URI=hdfs://namenode:9000
AIRFLOW_DBT_TARGET=local
AIRFLOW_DBT_DATABASE=default
AIRFLOW_DBT_SCHEMA=olist_analytics
AIRFLOW_DBT_BRONZE_SCHEMA=olist_bronze
AIRFLOW_DBT_SILVER_SCHEMA=silver
AIRFLOW_DBT_GOLD_SCHEMA=gold
AIRFLOW_DBT_THREADS=4
AIRFLOW_DBT_USER=airflow
AIRFLOW_SUPERSET_URL=http://superset:8088
AIRFLOW_SUPERSET_HEALTH_ENDPOINT=/health
AIRFLOW_SUPERSET_REFRESH_ENDPOINT=/health

# Superset authentication for the idempotent metadata refresh step.
# Set either a bearer token or username/password pair.
AIRFLOW_SUPERSET_ACCESS_TOKEN=
AIRFLOW_SUPERSET_USERNAME=
AIRFLOW_SUPERSET_PASSWORD=
